#!/bin/sh

# fail fast, including unset variables
set -eu

# parse and derive params
BUILD_DIR=$1
CACHE_DIR=$2
LP_DIR=`cd $(dirname $0); cd ..; pwd`
BUILDPACK_DIR="$(dirname $(dirname $0))"
VENDORED_CALIBRE="vendor/calibre"

echo "BUILD_DIR: $BUILD_DIR"
echo "CACHE_DIR: $CACHE_DIR"
echo "BUILDPACK_DIR: $BUILDPACK_DIR"

rm -rf "$BUILD_DIR/$VENDORED_CALIBRE"
mkdir -p "$BUILD_DIR/vendor"

echo "-----> Installing Calibre"

sh $BUILDPACK_DIR/bin/linux-installer.sh install_dir="$BUILD_DIR" isolated=y version=5.44.0

# libGL dependency required for image processing
echo "-----> Installing dependencies"
for dep in \
  https://archive.ubuntu.com/ubuntu/pool/main/libg/libglvnd/libgl1_1.0.0-2ubuntu2_amd64.deb \
  https://archive.ubuntu.com/ubuntu/pool/main/libg/libglvnd/libglvnd0_1.0.0-2ubuntu2_amd64.deb \
  https://archive.ubuntu.com/ubuntu/pool/main/libg/libglvnd/libglx0_1.0.0-2ubuntu2_amd64.deb \
  https://archive.ubuntu.com/ubuntu/pool/main/libx/libxcomposite/libxcomposite1_0.4.4-2_amd64.deb \
  https://archive.ubuntu.com/ubuntu/pool/main/n/nss/libnss3_3.49.1-1ubuntu1_amd64.deb \
  https://archive.ubuntu.com/ubuntu/pool/main/n/nspr/libnspr4_4.18-1ubuntu1_amd64.deb
do
  echo "$dep"
  curl --fail --location --silent --show-error \
    --retry 5 --retry-delay 2 --retry-connrefused \
    --remote-name "$dep"
  ar x *.deb
  tar xf data.tar.xz
  rm *.deb
done
mv ./usr/lib/x86_64-linux-gnu/* $BUILD_DIR/calibre/lib/

echo "-----> Setting up path"

mkdir -p $BUILD_DIR/.profile.d
echo "export PATH=\$HOME/calibre:\$PATH" > $BUILD_DIR/.profile.d/calibre.sh
echo $PATH

echo "-----> Calibre install done"
